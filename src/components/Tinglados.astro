---
import { getCachedPreferences } from "@lib/preferences";
import { CalculatorContainer } from "./React/CalculatorContainer";
import StructureSwipers from "./Swipers/StructureSwipers.astro";

const preferences = await getCachedPreferences();
---

<section class="w-full flex md:flex-row flex-col lg:gap-8 gap-4 pb-8">
  <div class="md:w-1/2">
    <article class="relative">
      <StructureSwipers type="tinglado" />
    </article>
  </div>
  <aside class="md:w-1/2 p-4">
    <h2 class="mb-4 text-slate-800">Tinglados</h2>
    <ul class="mb-4 list-disc list-inside text-slate-800">
      <li>
        Cabreadas y columnas de: hierro torsionado, alma llena, o perfil U.
      </li>
      <li>
        Perfilería para techo y laterales: Perfil de 100x50x2 mm galvanizado.
      </li>
      <li>Chapa de techo: Sincalum n°25, acanalada.</li>
    </ul>
    <CalculatorContainer
      client:load
      type="tinglados"
      preferences={preferences}
    />
  </aside>
</section>
