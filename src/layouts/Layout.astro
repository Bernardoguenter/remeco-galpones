---
import Footer from "@components/Footer/Footer.astro";
import Fonts from "@components/head/Fonts.astro";
import Header from "@components/Nav/Header.astro";
import WhatsappButton from "@components/WhatsappButton.astro";
import { ClientRouter } from "astro:transitions";
import "@styles/global.css";
import MetaTags from "@components/head/MetaTags.astro";
import Sitemap from "@components/head/Sitemap.astro";
import GTMHead from "@components/head/GtmHead.astro";
import GtmNoScript from "@components/head/GtmNoScript.astro";

const {
  title = "Metalúrgica Remeco",
  description = "Sitio web de Metalúrgica Remeco. Galponenes y tinglados para industria y agricultura. Envíos a todo el país. Servicio pre y post venta. Opciones de financiación.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <GTMHead />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.png"
    />
    <Sitemap />
    <Fonts />
    <MetaTags description={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-screen">
    <GtmNoScript />
    <Header />
    <slot />
    <Footer />
    <WhatsappButton />
  </body>
</html>
